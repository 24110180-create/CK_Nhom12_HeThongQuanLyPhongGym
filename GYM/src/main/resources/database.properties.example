# ==============================================================================
# FITLIFE GYM - MẪU CẤU HÌNH CƠ SỞ DỮ LIỆU (DATABASE PROPERTIES TEMPLATE)
# Sao chép file này thành 'database.properties' và điền thông tin của máy bạn
# ==============================================================================

# Thông số kết nối SQL Server
db.driver=com.microsoft.sqlserver.jdbc.SQLServerDriver
db.url=jdbc:sqlserver://localhost;databaseName=FitLifeGym;encrypt=true;trustServerCertificate=true;sendStringParametersAsUnicode=true;useUnicode=true;characterEncoding=UTF-8;
db.username=YOUR_SQL_USERNAME
db.password=YOUR_SQL_PASSWORD

# Cấu hình Connection Pool
hibernate.connection.pool_size=10
